            "time": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('time', 'Reservation time in HH:MM 24-hour format') }}",
            "guests": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('guests', 'Number of guests, integer 1-20', 'number') }}"
          },
